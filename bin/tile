#!/bin/sh
# Arrange Terminal.app windows running Claude Code / Codex. install.sh links this to ~/.local/bin/tile.
set -eu
TILE_HOME="${TILE_HOME:-$HOME/.local/share/tile}"
export TILE_HOME
case "${1-}" in
  --help|-h)
    cat <<'USAGE'
Usage: tile [--no-close] [row|grid] [font-size]

Arrange every Terminal.app window running Claude Code / Codex with the same font size and window size, edge to edge.
  (no args)    close windows not running Claude Code / Codex, then arrange; font size is chosen from the display
  --no-close   arrange without closing any window
  row          one full-height row with equal widths
  grid         grid with floor(sqrt(n)) rows
  14           use 14pt (can be combined with the options above)
Config: ~/.config/tile/priorities.json (theme order)
USAGE
    exit 0 ;;
  --version)
    cat "$TILE_HOME/VERSION" 2>/dev/null || echo unknown
    exit 0 ;;
esac
SCRIPT="$TILE_HOME/tile-terminals.scpt"
[ -f "$SCRIPT" ] || SCRIPT="$TILE_HOME/libexec/tile-terminals.applescript"
exec /usr/bin/osascript "$SCRIPT" "$@"
